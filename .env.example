# 完整 Chat Completions 地址，或以 /v1 结尾的兼容服务地址
api_url=https://your-model-service.example/v1/chat/completions
model_name=your-model-name
api_key=

# 可选调优；不填写时继承加密保存的设置，再使用以下默认值。
# 禁用工具请设 false；仅将轮数设为 0 仍会发送工具定义和 tool_choice=none。
# MODEL_ENABLE_TOOLS=true
# 输出模式：omitted（仅提示 JSON，不发 response_format）、json_object、json_schema。
# 后两项需服务支持；失败不会自动降级或重试另一模式。
# MODEL_RESPONSE_FORMAT=omitted
# MODEL_MAX_TOOL_ROUNDS=2
# MODEL_MAX_OUTPUT_TOKENS=1500
# MODEL_TIMEOUT_SECONDS=30
# MODEL_MAX_REQUESTS_PER_MATCH=60
# MODEL_MAX_TOKENS_PER_MATCH=200000
# MODEL_MAX_CONCURRENT_REQUESTS=1
