<Window x:Class="HsHelper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="炉石猎人助手" Width="1180" Height="800" MinWidth="760" MinHeight="480" Background="#F3F5F7" Loaded="WindowLoaded" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="BattleEntityTextTemplate">
      <StackPanel Margin="0,3" ToolTipService.ShowDuration="20000">
        <StackPanel.ToolTip><ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><StackPanel MaxWidth="420"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding EffectTextStatus}" Foreground="#7B5A22" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding EffectTextDisplay}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></ToolTip></StackPanel.ToolTip>
        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding EffectTextDisplay}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"/>
        <TextBlock Text="{Binding EffectTextStatus}" TextWrapping="Wrap" FontSize="11" Foreground="#7B5A22" Margin="0,2,0,0"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="炉石猎人助手" FontSize="28" FontWeight="SemiBold" Foreground="#173A2A"/>
      <TextBlock Text="标准天梯 · 国服 · 卡库与对局实验版" Foreground="#52625A" Margin="0,6,0,0"/>
      <WrapPanel Margin="0,8,0,0"><Button Content="显示／隐藏悬浮窗" Click="OverlayClicked"/><Button Content="悬浮窗设置" Click="OverlaySettingsClicked"/><TextBlock x:Name="HotkeyText" Text="快捷键等待初始化" VerticalAlignment="Center" Foreground="#52625A" TextWrapping="Wrap"/></WrapPanel>
      <TextBlock x:Name="ConnectionText" Text="尚未连接日志。" TextWrapping="Wrap" Foreground="#52625A" FontSize="12" Margin="0,4,0,0"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Padding="12" Background="#E1EBE4" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="正在初始化…" TextWrapping="Wrap"/></Border>
    <TabControl x:Name="MainTabs" Background="White">
      <TabItem Header="对局与日志">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LogPathBox" ToolTip="炉石安装目录、Logs目录或Power.log路径" TextChanged="LogPathChanged"/><Button Grid.Column="1" Content="自动诊断" Click="DiagnoseClicked"/><Button Grid.Column="2" Content="选择日志回放" Click="ReplayClicked"/></Grid>
          <WrapPanel Grid.Row="1"><TextBlock Text="我方视角" VerticalAlignment="Center" Margin="0,0,6,6"/><ComboBox x:Name="PlayerBox" Width="110" SelectedIndex="0" Margin="0,0,12,6" SelectionChanged="PlayerChanged"><ComboBoxItem Content="自动识别"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/></ComboBox><TextBlock Text="记录套牌" VerticalAlignment="Center" Margin="0,0,6,6"/><ComboBox x:Name="SavedDeckBox" Width="190" DisplayMemberPath="Label" Margin="0,0,10,6" SelectionChanged="SavedDeckChanged"/><Button Content="开始监听" Click="WatchClicked"/><Button Content="停止" Click="StopClicked"/><Button Content="日志配置预览" Click="PreviewConfigClicked"/><Button Content="导出局面" Click="ExportClicked"/><Button Content="返回当前局面" Click="ReturnLiveClicked"/></WrapPanel>
          <StackPanel Grid.Row="2" Margin="0,6,0,10"><TextBlock x:Name="StateText" Text="请连接日志或选择日志回放。" TextWrapping="Wrap"/><TextBlock x:Name="AccessText" Text="尚无可分析局面。" Foreground="#7B5A22" TextWrapping="Wrap" Margin="0,4"/><WrapPanel><Button Content="本地概率与动作计算" Click="LocalToolsClicked"/><Button Content="复盘最后观察局面" Click="ReviewLastClicked"/><Button Content="从日志重建局面" Click="RebuildClicked"/></WrapPanel></StackPanel>
          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Grid x:Name="BattleViewRoot"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <GroupBox Header="我方" Padding="10" Margin="0,0,6,8"><StackPanel>
                  <TextBlock Text="{Binding Local.Hero.Name, TargetNullValue=英雄未知, FallbackValue=英雄未知}" FontSize="18" FontWeight="SemiBold"/>
                  <WrapPanel><TextBlock Text="生命 "/><TextBlock Text="{Binding Local.Hero.Health, TargetNullValue=?, FallbackValue=?}"/><TextBlock Text=" · 护甲 "/><TextBlock Text="{Binding Local.Hero.Armor, TargetNullValue=?, FallbackValue=?}"/><TextBlock Text=" · 法力 "/><TextBlock Text="{Binding Local.ManaAvailable, TargetNullValue=?, FallbackValue=?}"/><TextBlock Text=" / "/><TextBlock Text="{Binding Local.ManaTotal, TargetNullValue=?, FallbackValue=?}"/></WrapPanel>
                  <WrapPanel><TextBlock Text="手牌 "/><TextBlock Text="{Binding Local.HandCount, TargetNullValue=?, FallbackValue=?}"/><TextBlock Text=" · 牌库 "/><TextBlock Text="{Binding Local.DeckCount, TargetNullValue=?, FallbackValue=?}"/></WrapPanel>
                  <TextBlock Text="武器" FontWeight="SemiBold" Margin="0,8,0,2"/><WrapPanel><TextBlock Text="{Binding Local.Weapon.Name, TargetNullValue=未观察到武器, FallbackValue=未观察到武器}"/><TextBlock Text=" · 攻击 "/><TextBlock Text="{Binding Local.Weapon.Attack, TargetNullValue=?, FallbackValue=?}"/><TextBlock Text=" · 耐久 "/><TextBlock Text="{Binding Local.Weapon.Durability, TargetNullValue=?, FallbackValue=?}"/></WrapPanel>
                  <TextBlock Text="英雄技能（疲劳状态不等于可使用）" FontWeight="SemiBold" Margin="0,8,0,2"/><WrapPanel><TextBlock Text="{Binding Local.HeroPower.Name, TargetNullValue=技能未知, FallbackValue=技能未知}"/><TextBlock Text=" · 费用 "/><TextBlock Text="{Binding Local.HeroPower.Cost, TargetNullValue=?, FallbackValue=?}"/><TextBlock Text=" · 状态 "/><TextBlock Text="{Binding Local.HeroPower.Status, TargetNullValue=未知, FallbackValue=未知}"/></WrapPanel>
                  <TextBlock Text="手牌" FontWeight="SemiBold" Margin="0,10,0,4"/>
                  <DataGrid x:Name="OwnHandGrid" ItemsSource="{Binding Local.Hand}" MinHeight="65" MaxHeight="210"><DataGrid.Columns><DataGridTextColumn Header="费用" Binding="{Binding Cost,TargetNullValue=?, FallbackValue=?}" Width="45"/><DataGridTemplateColumn Header="卡牌与效果" CellTemplate="{StaticResource BattleEntityTextTemplate}" Width="*"/><DataGridTextColumn Header="攻" Binding="{Binding Attack,TargetNullValue=?, FallbackValue=?}" Width="35"/><DataGridTextColumn Header="血" Binding="{Binding Health,TargetNullValue=?, FallbackValue=?}" Width="35"/></DataGrid.Columns></DataGrid>
                  <TextBlock Text="场面" FontWeight="SemiBold" Margin="0,10,0,4"/>
                  <DataGrid x:Name="OwnBoardGrid" ItemsSource="{Binding Local.Board}" MinHeight="65" MaxHeight="210"><DataGrid.Columns><DataGridTemplateColumn Header="卡牌与效果" CellTemplate="{StaticResource BattleEntityTextTemplate}" Width="*"/><DataGridTextColumn Header="攻" Binding="{Binding Attack,TargetNullValue=?, FallbackValue=?}" Width="35"/><DataGridTextColumn Header="血" Binding="{Binding Health,TargetNullValue=?, FallbackValue=?}" Width="35"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid>
                </StackPanel></GroupBox>
                <GroupBox Grid.Column="1" Header="对手公开信息" Padding="10" Margin="6,0,0,8"><StackPanel>
                  <TextBlock Text="{Binding Opponent.Hero.Name, TargetNullValue=英雄未知, FallbackValue=英雄未知}" FontSize="18" FontWeight="SemiBold"/>
                  <WrapPanel><TextBlock Text="生命 "/><TextBlock Text="{Binding Opponent.Hero.Health, TargetNullValue=?, FallbackValue=?}"/><TextBlock Text=" · 护甲 "/><TextBlock Text="{Binding Opponent.Hero.Armor, TargetNullValue=?, FallbackValue=?}"/><TextBlock Text=" · 法力 "/><TextBlock Text="{Binding Opponent.ManaAvailable, TargetNullValue=?, FallbackValue=?}"/><TextBlock Text=" / "/><TextBlock Text="{Binding Opponent.ManaTotal, TargetNullValue=?, FallbackValue=?}"/></WrapPanel>
                  <WrapPanel><TextBlock Text="手牌数量 "/><TextBlock Text="{Binding Opponent.HandCount, TargetNullValue=?, FallbackValue=?}"/><TextBlock Text=" · 牌库 "/><TextBlock Text="{Binding Opponent.DeckCount, TargetNullValue=?, FallbackValue=?}"/></WrapPanel>
                  <TextBlock Text="武器" FontWeight="SemiBold" Margin="0,8,0,2"/><WrapPanel><TextBlock Text="{Binding Opponent.Weapon.Name, TargetNullValue=未观察到武器, FallbackValue=未观察到武器}"/><TextBlock Text=" · 攻击 "/><TextBlock Text="{Binding Opponent.Weapon.Attack, TargetNullValue=?, FallbackValue=?}"/><TextBlock Text=" · 耐久 "/><TextBlock Text="{Binding Opponent.Weapon.Durability, TargetNullValue=?, FallbackValue=?}"/></WrapPanel>
                  <TextBlock Text="英雄技能" FontWeight="SemiBold" Margin="0,8,0,2"/><WrapPanel><TextBlock Text="{Binding Opponent.HeroPower.Name, TargetNullValue=技能未知, FallbackValue=技能未知}"/><TextBlock Text=" · 费用 "/><TextBlock Text="{Binding Opponent.HeroPower.Cost, TargetNullValue=?, FallbackValue=?}"/></WrapPanel>
                  <TextBlock Text="场面" FontWeight="SemiBold" Margin="0,10,0,4"/>
                  <DataGrid x:Name="OpponentBoardGrid" ItemsSource="{Binding Opponent.Board}" MinHeight="65" MaxHeight="210"><DataGrid.Columns><DataGridTemplateColumn Header="卡牌与效果" CellTemplate="{StaticResource BattleEntityTextTemplate}" Width="*"/><DataGridTextColumn Header="攻" Binding="{Binding Attack,TargetNullValue=?, FallbackValue=?}" Width="35"/><DataGridTextColumn Header="血" Binding="{Binding Health,TargetNullValue=?, FallbackValue=?}" Width="35"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid>
                  <TextBlock Text="已公开打出（不等于当前手牌）" FontWeight="SemiBold" Margin="0,10,0,4"/>
                  <DataGrid ItemsSource="{Binding Opponent.PublicPlays}" MinHeight="65" MaxHeight="210"><DataGrid.Columns><DataGridTextColumn Header="卡牌" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="实体" Binding="{Binding EntityId}" Width="55"/></DataGrid.Columns></DataGrid>
                </StackPanel></GroupBox>
                <GroupBox Grid.Row="1" Header="已知剩余牌库" Padding="10" Margin="0,0,6,8"><StackPanel>
                  <TextBlock x:Name="DeckCompositionStatusText" Text="{Binding DeckSummary}" TextWrapping="Wrap"/>
                  <WrapPanel Margin="0,4"><TextBlock Text="剩余总数 "/><TextBlock Text="{Binding Local.DeckCount, TargetNullValue=未知, FallbackValue=未知}"/><TextBlock Text=" · 未知牌数 "/><TextBlock Text="{Binding UnknownDeckCards, TargetNullValue=未知, FallbackValue=未知}"/></WrapPanel>
                  <DataGrid x:Name="RemainingDeckGrid" ItemsSource="{Binding RemainingDeck}" MinHeight="65" MaxHeight="220"><DataGrid.Columns><DataGridTextColumn Header="卡牌" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="已知剩余" Binding="{Binding Copies}" Width="80"/></DataGrid.Columns></DataGrid>
                </StackPanel></GroupBox>
                <GroupBox Grid.Row="1" Grid.Column="1" Header="当前我方选择" Padding="10" Margin="6,0,0,8"><StackPanel>
                  <TextBlock x:Name="CurrentChoiceStatusText" Text="{Binding ChoiceStatus}" TextWrapping="Wrap"/>
                  <DataGrid x:Name="CurrentChoicesGrid" ItemsSource="{Binding Choice.Options}" MinHeight="65" MaxHeight="220" Margin="0,6,0,0"><DataGrid.Columns><DataGridTextColumn Header="序号" Binding="{Binding Position, TargetNullValue=未知, FallbackValue=未知}" Width="50"/><DataGridTemplateColumn Header="候选卡牌与效果" CellTemplate="{StaticResource BattleEntityTextTemplate}" Width="*"/><DataGridTextColumn Header="实体" Binding="{Binding EntityId}" Width="60"/></DataGrid.Columns></DataGrid>
                </StackPanel></GroupBox>
                <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="局面质量与限制" Padding="10" Margin="0,0,0,8"><StackPanel>
                  <TextBlock x:Name="BattleQualityText" Text="{Binding QualitySummary}" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#7B5A22"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></GroupBox>
              </Grid>
              <Expander Header="局面数据详情"><DataGrid x:Name="EntityGrid" MaxHeight="300"><DataGrid.Columns><DataGridTextColumn Header="实体" Binding="{Binding Id}" Width="60"/><DataGridTextColumn Header="控制者" Binding="{Binding ControllerId}" Width="70"/><DataGridTextColumn Header="区域" Binding="{Binding Zone}" Width="110"/><DataGridTextColumn Header="卡牌ID" Binding="{Binding CardId}" Width="*"/><DataGridTextColumn Header="费用" Binding="{Binding Cost}" Width="55"/><DataGridTextColumn Header="攻击" Binding="{Binding Attack}" Width="55"/><DataGridTextColumn Header="生命" Binding="{Binding RemainingHealth}" Width="55"/></DataGrid.Columns></DataGrid></Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="中文卡库">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel><TextBlock Text="导入 build" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="ImportBuildBox" Width="95" ToolTip="导入JSON的数字build版本"/><Button Content="导入卡牌JSON" Click="ImportCardsClicked"/><Button Content="同步客户端版本卡库" Click="SyncCurrentBuildClicked" ToolTip="使用已观察到的客户端 build；未确认版本时先诊断或连接日志。"/><Button Content="同步最新卡库" Click="SyncCardsClicked"/><Button Content="同步标准系列池" Click="SyncPoolClicked"/><Button Content="导入完整卡池规则" Click="ImportPoolClicked"/><TextBlock x:Name="CatalogText" VerticalAlignment="Center" Text="尚未加载卡库"/></WrapPanel>
          <WrapPanel Grid.Row="1"><TextBox x:Name="SearchBox" Width="300" ToolTip="输入中文名称或效果" KeyDown="SearchKeyDown"/><TextBlock Text="关键词" VerticalAlignment="Center" Margin="0,0,6,6"/><TextBox x:Name="KeywordBox" Width="100" ToolTip="如 BATTLECRY、DEATHRATTLE"/><CheckBox x:Name="HunterOnlyBox" Content="猎人与中立" IsChecked="True" VerticalAlignment="Center" Margin="8"/><CheckBox x:Name="StandardPoolBox" Content="标准系列成员" VerticalAlignment="Center" Margin="8"/><Button Content="搜索" Click="SearchClicked"/></WrapPanel>
          <TextBlock Grid.Row="2" x:Name="PoolStatusText" Text="尚未加载标准卡池证据。" Foreground="#7B5A22" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><DataGrid x:Name="CardGrid" SelectionChanged="CardSelected"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="140"/><DataGridTextColumn Header="费用" Binding="{Binding Cost}" Width="45"/><DataGridTextColumn Header="职业" Binding="{Binding CardClass}" Width="90"/><DataGridTextColumn Header="效果" Binding="{Binding Text}" Width="*"/><DataGridTextColumn Header="合法性" Binding="{Binding StandardLegality}" Width="80"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Margin="10,0,0,0"><Image x:Name="CardImage" MaxHeight="330" Stretch="Uniform"/><TextBlock x:Name="CardImageText" Text="选择卡牌查看图片" TextWrapping="Wrap"/></StackPanel></Grid>
        </Grid>
      </TabItem>
      <TabItem Header="套牌">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="粘贴游戏导出的套牌代码。保存为不可变版本后，在对局页选择实际使用的套牌。" Margin="0,0,0,10"/><TextBox Grid.Row="1" x:Name="DeckBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><StackPanel Grid.Row="2"><WrapPanel><TextBox x:Name="DeckNameBox" Text="野兽快" Width="140"/><Button Content="解析牌码" Click="DecodeClicked"/><Button Content="保存到套牌库" Click="SaveDeckToLibraryClicked"/><Button x:Name="ExportDeckJsonButton" Content="导出套牌JSON" Click="SaveDeckClicked"/><Button x:Name="ExportDeckCodeButton" Content="导出牌码文本" Click="ExportDeckCodeClicked"/></WrapPanel><TextBlock x:Name="DeckExportStatusText" Text="JSON 保留匹配的已保存版本及原名称；修改牌码后按未保存草稿导出。" TextWrapping="Wrap" Margin="0,4,0,8"/></StackPanel><TextBox Grid.Row="3" x:Name="DeckResultBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Grid>
      </TabItem>
      <TabItem x:Name="KnowledgeTab" Header="计划与笔记">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel><TextBlock Text="套牌版本" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="PlanDeckBox" Width="300" DisplayMemberPath="Label" SelectionChanged="PlanDeckChanged"/><Button x:Name="KnowledgeRefreshButton" Content="刷新" Click="RefreshKnowledgeClicked"/><Button Content="AI 分析套牌计划" Click="AnalyzeDeckPlanClicked"/><Button Content="查看套牌分析记录" Click="ViewDeckAdviceArchiveClicked"/></WrapPanel>
          <StackPanel Grid.Row="1"><TextBlock x:Name="KnowledgeStatusText" Text="先保存一个套牌版本。" TextWrapping="Wrap"/><WrapPanel><ComboBox x:Name="KnowledgeTypeFilterBox" Width="125" SelectedIndex="0" SelectionChanged="KnowledgeFilterChanged"><ComboBoxItem Content="全部计划与笔记"/><ComboBoxItem Content="只看套牌计划"/><ComboBoxItem Content="只看对局笔记"/></ComboBox><TextBlock Text="标题包含" VerticalAlignment="Center" Margin="8,0,6,6"/><TextBox x:Name="KnowledgeTitleFilterBox" Width="230" MaxLength="200" TextChanged="KnowledgeFilterChanged" ToolTip="按字面标题片段筛选，空格和符号按原样匹配"/><Button x:Name="KnowledgePrevPageButton" Content="上一页" Click="KnowledgePrevPageClicked" IsEnabled="False"/><TextBlock x:Name="KnowledgePageText" Text="第 1 页 · 尚未读取" VerticalAlignment="Center" Margin="8,0,8,6"/><Button x:Name="KnowledgeNextPageButton" Content="下一页" Click="KnowledgeNextPageClicked" IsEnabled="False"/></WrapPanel><TextBlock Text="计划和笔记会按版本保存，作为分析参考。历史复盘只读取当时已经保存的版本；翻页与筛选保留当前草稿。" Foreground="#52625A" TextWrapping="Wrap" Margin="0,5,0,12"/></StackPanel>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ListBox x:Name="KnowledgeList" DisplayMemberPath="Label" SelectionChanged="KnowledgeSelected" Margin="0,0,12,0"/>
            <Grid x:Name="KnowledgeEditor" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <WrapPanel><ComboBox x:Name="KnowledgeKindBox" Width="100" SelectedIndex="0" SelectionChanged="KnowledgeEditorChanged"><ComboBoxItem Content="套牌计划"/><ComboBoxItem Content="对局笔记"/></ComboBox><TextBlock Text="对手职业" Margin="10,7,6,0"/><TextBox x:Name="PlanOpponentBox" Width="90" ToolTip="如 MAGE，留空为通用计划" TextChanged="KnowledgeEditorChanged"/><ComboBox x:Name="PlanFirstBox" Width="90" SelectedIndex="0" SelectionChanged="KnowledgeEditorChanged"><ComboBoxItem Content="先后手通用"/><ComboBoxItem Content="先手"/><ComboBoxItem Content="后手"/></ComboBox></WrapPanel>
              <TextBox Grid.Row="1" x:Name="KnowledgeTitleBox" ToolTip="标题，如野兽快获胜方式或对阵法师留牌" TextChanged="KnowledgeEditorChanged"/>
              <StackPanel Grid.Row="2" Margin="0,4,0,8"><TextBlock x:Name="KnowledgeVersionText" Text="新条目。可记录获胜方式、留牌、配合、风险和复盘问题。" TextWrapping="Wrap"/><TextBlock x:Name="KnowledgeEditorStatusText" Foreground="#7B5A22" TextWrapping="Wrap"/><WrapPanel><Button x:Name="OpenKnowledgeSnapshotButton" Content="打开关联局面" Click="OpenKnowledgeSnapshotClicked" IsEnabled="False"/><ComboBox x:Name="KnowledgeSnapshotVersionBox" Width="430" DisplayMemberPath="Label" Visibility="Collapsed" ToolTip="同一事件存在多个保存版本时，请明确选择实际版本。"/></WrapPanel><TextBlock x:Name="KnowledgeNavigationStatusText" Foreground="#52625A" TextWrapping="Wrap"/></StackPanel>
              <TextBox Grid.Row="3" x:Name="KnowledgeContentBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15" TextChanged="KnowledgeEditorChanged"/>
              <WrapPanel Grid.Row="4"><Button x:Name="SaveKnowledgeButton" Content="保存新版本" Click="SaveKnowledgeClicked"/><Button x:Name="NewKnowledgeButton" Content="新建条目" Click="NewKnowledgeClicked"/><Button x:Name="DeleteKnowledgeButton" Content="删除当前条目" Click="DeleteKnowledgeClicked"/><Button x:Name="DiscardKnowledgeChangesButton" Content="放弃未保存修改" Click="DiscardKnowledgeChangesClicked" IsEnabled="False"/></WrapPanel>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="对局记录">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><WrapPanel><Button x:Name="HistoryRefreshButton" Content="刷新对局与战绩" Click="RefreshHistoryClicked"/><CheckBox x:Name="RankedOnlyBox" Checked="HistoryFilterChanged" Unchecked="HistoryFilterChanged" Content="仅天梯" IsChecked="True" Margin="8"/><TextBlock Text="build" Margin="8"/><TextBox x:Name="StatsBuildBox" TextChanged="HistoryFilterChanged" Width="80"/><TextBlock Text="套牌版本ID" Margin="8"/><TextBox x:Name="StatsDeckBox" TextChanged="HistoryFilterChanged" Width="110"/><TextBlock Text="对手职业" Margin="8"/><TextBox x:Name="StatsOpponentBox" TextChanged="HistoryFilterChanged" Width="85" ToolTip="如 MAGE，留空显示全部职业"/><ComboBox x:Name="StatsFirstBox" SelectionChanged="HistoryFilterChanged" Width="85" SelectedIndex="0"><ComboBoxItem Content="先后手全部"/><ComboBoxItem Content="先手"/><ComboBoxItem Content="后手"/></ComboBox></WrapPanel><WrapPanel><Button x:Name="SessionPrevPageButton" Content="上一页" Click="HistoryPrevPageClicked" IsEnabled="False"/><TextBlock x:Name="HistoryPageText" Text="第 1 页 · 尚未读取" VerticalAlignment="Center" Margin="8"/><Button x:Name="SessionNextPageButton" Content="下一页" Click="HistoryNextPageClicked" IsEnabled="False"/></WrapPanel><WrapPanel><TextBlock x:Name="StatsText" VerticalAlignment="Center" Text="暂无记录" TextWrapping="Wrap"/><TextBlock Text="保留天数" Margin="20,7,6,0"/><TextBox x:Name="RetentionDaysBox" Text="30" Width="55"/><Button Content="清理旧的已结束对局" Click="CleanupHistoryClicked"/></WrapPanel></StackPanel>
          <DataGrid Grid.Row="1" x:Name="SessionsGrid" SelectionChanged="SessionSelected"><DataGrid.Columns><DataGridTextColumn Header="记录时间" Binding="{Binding Time}" Width="140"/><DataGridTextColumn Header="套牌版本" Binding="{Binding Deck}" Width="*"/><DataGridTextColumn Header="对手职业" Binding="{Binding Opponent}" Width="110"/><DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="80"/><DataGridTextColumn Header="回合" Binding="{Binding Value.TurnCount}" Width="60"/><DataGridTextColumn Header="build" Binding="{Binding Value.CardBuild}" Width="100"/><DataGridTextColumn Header="完整" Binding="{Binding Value.IsComplete}" Width="60"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="2" Margin="0,10"><TextBlock x:Name="HistoryStatusText" Text="选择一局，再选择回合决策点。分析只使用该时刻及以前的信息。" TextWrapping="Wrap"/><WrapPanel><Button Content="标记关键回合" Click="MarkDecisionClicked"/><Button Content="查看本局建议记录" Click="ViewAdviceArchiveClicked"/></WrapPanel></StackPanel>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox x:Name="DecisionsList" DisplayMemberPath="Label" SelectionChanged="DecisionSelected" Margin="0,0,12,0"/><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions><Button Content="在 AI 教练分析选中局面" Click="AnalyzeHistoryClicked" HorizontalAlignment="Left"/><TextBox Grid.Row="1" x:Name="HistorySnapshotText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><DataGrid Grid.Row="2" x:Name="EventsGrid"><DataGrid.Columns><DataGridTextColumn Header="事件" Binding="{Binding EventSequence}" Width="65"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="120"/><DataGridTextColumn Header="说明" Binding="{Binding Summary}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Grid>
        </Grid>
      </TabItem>
      <TabItem Header="AI 教练">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="完整模型接口地址" Margin="0,0,0,5"/><TextBox x:Name="EndpointBox" ToolTip="完整Chat Completions接口地址，如 https://你的服务/v1/chat/completions" TextChanged="ModelConfigurationChanged"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="模型名称" Margin="0,0,0,5"/><TextBox x:Name="ModelBox" ToolTip="模型名称" TextChanged="ModelConfigurationChanged"/></StackPanel></Grid>
          <WrapPanel Grid.Row="1"><TextBlock Text="API密钥" VerticalAlignment="Center" Margin="0,0,8,6"/><PasswordBox x:Name="KeyBox" Width="250" Padding="7" Margin="0,0,16,6" PasswordChanged="ModelConfigurationChanged"/><TextBlock Text="局面对应的卡库build" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="SessionBuildBox" Width="120" ToolTip="与当前国服客户端核对后的数字build" TextChanged="BuildChanged"/></WrapPanel>
          <StackPanel Grid.Row="2"><WrapPanel><Button Content="从 .env 重新加载" Click="LoadEnvironmentClicked"/><Button Content="加密保存配置" Click="SaveModelClicked"/><Button Content="模型与预算设置" Click="ModelOptionsClicked"/><Button x:Name="CheckModelButton" Content="检查连接" Click="CheckModelClicked"/></WrapPanel><TextBlock x:Name="ModelConfigText" Text="尚未配置模型。" TextWrapping="Wrap"/><TextBlock Text="分析会将过滤后的局面和相关卡牌发送到配置的模型服务。动作与斩杀仅在本地规则完整覆盖时确认。" TextWrapping="Wrap" Foreground="#52625A" Margin="0,4,0,12"/><TextBlock x:Name="BudgetText" Text="单局预算：60次模型请求、200,000令牌。用量保存在本机。" Foreground="#52625A" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Row="3"><WrapPanel><ComboBox x:Name="TaskBox" Width="110" SelectedIndex="0" SelectionChanged="AdviceTaskChanged" Margin="0,0,10,6"><ComboBoxItem Content="回合建议"/><ComboBoxItem Content="留牌建议"/><ComboBoxItem Content="局面复盘"/><ComboBoxItem Content="选择建议"/></ComboBox><Button x:Name="AnalyzeButton" Content="分析当前局面" Click="AnalyzeClicked"/><Button Content="取消分析" Click="CancelAdviceClicked"/><CheckBox x:Name="AutoAdviceBox" Content="稳定决策点自动建议" IsChecked="False" Checked="AutomaticAdviceChanged" Unchecked="AutomaticAdviceChanged" Margin="10"/></WrapPanel><WrapPanel><TextBlock Text="本次提问（可选）" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="QuestionBox" Width="450" Height="42" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="针对固定局面提问，或在赛前套牌分析中询问计划。" TextChanged="QuestionChanged"/><Button Content="抢血还是解场" Tag="本回合应该抢血还是解场？请说明关键取舍。" Click="QuickQuestionClicked"/><Button Content="起手留牌" Tag="这些已确认的起手牌哪些应保留或替换？" Click="QuickQuestionClicked"/><Button Content="比较候选" Tag="当前已确认的候选应该选哪个？" Click="QuickQuestionClicked"/></WrapPanel></StackPanel>
          <TextBox Grid.Row="4" x:Name="AdviceBox" Text="连接或回放日志后，可为固定局面请求建议。" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15"/>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
