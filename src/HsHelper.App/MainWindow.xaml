<Window x:Class="HsHelper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="炉石猎人助手" Width="1180" Height="800" MinWidth="920" MinHeight="640" Background="#F3F5F7" Loaded="WindowLoaded">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="炉石猎人助手" FontSize="28" FontWeight="SemiBold" Foreground="#173A2A"/>
      <TextBlock Text="标准天梯 · 国服 · 卡库与对局实验版" Foreground="#52625A" Margin="0,6,0,0"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Padding="12" Background="#E1EBE4" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="正在初始化…" TextWrapping="Wrap"/></Border>
    <TabControl Background="White">
      <TabItem Header="对局与日志">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LogPathBox" ToolTip="炉石安装目录、Logs目录或Power.log路径" TextChanged="LogPathChanged"/><Button Grid.Column="1" Content="自动诊断" Click="DiagnoseClicked"/><Button Grid.Column="2" Content="选择日志回放" Click="ReplayClicked"/></Grid>
          <WrapPanel Grid.Row="1"><TextBlock Text="我方玩家ID" VerticalAlignment="Center" Margin="0,0,6,6"/><ComboBox x:Name="PlayerBox" Width="130" SelectedIndex="0" Margin="0,0,12,6" SelectionChanged="PlayerChanged"><ComboBoxItem Content="未确认"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/></ComboBox><Button Content="开始监听" Click="WatchClicked"/><Button Content="停止" Click="StopClicked"/><Button Content="日志配置预览" Click="PreviewConfigClicked"/><Button Content="导出局面" Click="ExportClicked"/></WrapPanel>
          <TextBlock Grid.Row="2" x:Name="StateText" Text="请连接日志或选择一份日志回放。玩家ID需通过实际对局核对。" TextWrapping="Wrap" Margin="0,6,0,12"/>
          <DataGrid Grid.Row="3" x:Name="EntityGrid"><DataGrid.Columns><DataGridTextColumn Header="实体" Binding="{Binding Id}" Width="60"/><DataGridTextColumn Header="控制者" Binding="{Binding ControllerId}" Width="70"/><DataGridTextColumn Header="区域" Binding="{Binding Zone}" Width="110"/><DataGridTextColumn Header="卡牌ID" Binding="{Binding CardId}" Width="*"/><DataGridTextColumn Header="位置" Binding="{Binding ZonePosition}" Width="55"/><DataGridTextColumn Header="费用" Binding="{Binding Cost}" Width="55"/><DataGridTextColumn Header="攻击" Binding="{Binding Attack}" Width="55"/><DataGridTextColumn Header="生命" Binding="{Binding RemainingHealth}" Width="55"/></DataGrid.Columns></DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="中文卡库">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel><TextBlock Text="导入 build" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="ImportBuildBox" Width="120" ToolTip="导入JSON的数字build版本"/><Button Content="导入卡牌JSON" Click="ImportCardsClicked"/><Button Content="同步最新卡库" Click="SyncCardsClicked"/><TextBlock x:Name="CatalogText" VerticalAlignment="Center" Text="尚未加载卡库"/></WrapPanel>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" ToolTip="输入中文名称或效果" KeyDown="SearchKeyDown"/><CheckBox Grid.Column="1" x:Name="HunterOnlyBox" Content="猎人可用职业" IsChecked="True" VerticalAlignment="Center" Margin="8"/><Button Grid.Column="2" Content="搜索" Click="SearchClicked"/></Grid>
          <TextBlock Grid.Row="2" Text="卡库同步不代表国服已上线或标准合法。当前标准卡池规则尚待实测接入，合法性显示未知。" Foreground="#7B5A22" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <DataGrid Grid.Row="3" x:Name="CardGrid"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="费用" Binding="{Binding Cost}" Width="50"/><DataGridTextColumn Header="职业" Binding="{Binding CardClass}" Width="100"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="效果" Binding="{Binding Text}" Width="*"/><DataGridTextColumn Header="标准合法性" Binding="{Binding StandardLegality}" Width="100"/></DataGrid.Columns></DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="套牌">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="粘贴游戏导出的套牌代码，可附带 # 开头的说明。" Margin="0,0,0,10"/><TextBox Grid.Row="1" x:Name="DeckBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><WrapPanel Grid.Row="2"><Button Content="解析牌码" Click="DecodeClicked"/><Button Content="保存套牌记录" Click="SaveDeckClicked"/></WrapPanel><TextBox Grid.Row="3" x:Name="DeckResultBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Grid>
      </TabItem>
      <TabItem Header="AI 教练">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="完整模型接口地址" Margin="0,0,0,5"/><TextBox x:Name="EndpointBox" ToolTip="完整Chat Completions接口地址，如 https://你的服务/v1/chat/completions"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="模型名称" Margin="0,0,0,5"/><TextBox x:Name="ModelBox" ToolTip="模型名称"/></StackPanel></Grid>
          <WrapPanel Grid.Row="1"><TextBlock Text="API密钥（仅本次运行）" VerticalAlignment="Center" Margin="0,0,8,6"/><PasswordBox x:Name="KeyBox" Width="250" Padding="7" Margin="0,0,16,6"/><TextBlock Text="局面对应的卡库build" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="SessionBuildBox" Width="120" ToolTip="与当前国服客户端核对后的数字build" TextChanged="BuildChanged"/></WrapPanel>
          <TextBlock Grid.Row="2" Text="点击分析会将过滤后的局面和相关卡牌发送到填写的模型服务。当前提供策略建议；完整牌效模拟和自动回合触发尚未接入。" TextWrapping="Wrap" Foreground="#52625A" Margin="0,4,0,12"/>
          <WrapPanel Grid.Row="3"><ComboBox x:Name="TaskBox" Width="110" SelectedIndex="0" Margin="0,0,10,6"><ComboBoxItem Content="回合建议"/><ComboBoxItem Content="留牌建议"/><ComboBoxItem Content="局面复盘"/></ComboBox><Button x:Name="AnalyzeButton" Content="分析当前局面" Click="AnalyzeClicked"/><Button Content="取消分析" Click="CancelAdviceClicked"/></WrapPanel>
          <TextBox Grid.Row="4" x:Name="AdviceBox" Text="连接或回放日志后，可为固定局面请求建议。" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15"/>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
