<Window x:Class="HsHelper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="炉石猎人助手" Width="1180" Height="800" MinWidth="920" MinHeight="640" Background="#F3F5F7" Loaded="WindowLoaded">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="炉石猎人助手" FontSize="28" FontWeight="SemiBold" Foreground="#173A2A"/>
      <TextBlock Text="标准天梯 · 国服 · 卡库与对局实验版" Foreground="#52625A" Margin="0,6,0,0"/>
      <WrapPanel Margin="0,8,0,0"><Button Content="显示／隐藏悬浮窗" Click="OverlayClicked"/><Button Content="悬浮窗设置" Click="OverlaySettingsClicked"/><TextBlock x:Name="HotkeyText" Text="快捷键等待初始化" VerticalAlignment="Center" Foreground="#52625A" TextWrapping="Wrap"/></WrapPanel>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Padding="12" Background="#E1EBE4" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="正在初始化…" TextWrapping="Wrap"/></Border>
    <TabControl x:Name="MainTabs" Background="White">
      <TabItem Header="对局与日志">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LogPathBox" ToolTip="炉石安装目录、Logs目录或Power.log路径" TextChanged="LogPathChanged"/><Button Grid.Column="1" Content="自动诊断" Click="DiagnoseClicked"/><Button Grid.Column="2" Content="选择日志回放" Click="ReplayClicked"/></Grid>
          <WrapPanel Grid.Row="1"><TextBlock Text="我方视角" VerticalAlignment="Center" Margin="0,0,6,6"/><ComboBox x:Name="PlayerBox" Width="110" SelectedIndex="0" Margin="0,0,12,6" SelectionChanged="PlayerChanged"><ComboBoxItem Content="自动识别"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/></ComboBox><TextBlock Text="记录套牌" VerticalAlignment="Center" Margin="0,0,6,6"/><ComboBox x:Name="SavedDeckBox" Width="190" DisplayMemberPath="Label" Margin="0,0,10,6" SelectionChanged="SavedDeckChanged"/><Button Content="开始监听" Click="WatchClicked"/><Button Content="停止" Click="StopClicked"/><Button Content="日志配置预览" Click="PreviewConfigClicked"/><Button Content="导出局面" Click="ExportClicked"/><Button Content="返回当前局面" Click="ReturnLiveClicked"/></WrapPanel>
          <TextBlock Grid.Row="2" x:Name="StateText" Text="请连接日志或选择一份日志回放。玩家ID需通过实际对局核对。" TextWrapping="Wrap" Margin="0,6,0,12"/>
          <DataGrid Grid.Row="3" x:Name="EntityGrid"><DataGrid.Columns><DataGridTextColumn Header="实体" Binding="{Binding Id}" Width="60"/><DataGridTextColumn Header="控制者" Binding="{Binding ControllerId}" Width="70"/><DataGridTextColumn Header="区域" Binding="{Binding Zone}" Width="110"/><DataGridTextColumn Header="卡牌ID" Binding="{Binding CardId}" Width="*"/><DataGridTextColumn Header="位置" Binding="{Binding ZonePosition}" Width="55"/><DataGridTextColumn Header="费用" Binding="{Binding Cost}" Width="55"/><DataGridTextColumn Header="攻击" Binding="{Binding Attack}" Width="55"/><DataGridTextColumn Header="生命" Binding="{Binding RemainingHealth}" Width="55"/></DataGrid.Columns></DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="中文卡库">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel><TextBlock Text="导入 build" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="ImportBuildBox" Width="95" ToolTip="导入JSON的数字build版本"/><Button Content="导入卡牌JSON" Click="ImportCardsClicked"/><Button Content="同步最新卡库" Click="SyncCardsClicked"/><Button Content="同步标准系列池" Click="SyncPoolClicked"/><Button Content="导入完整卡池规则" Click="ImportPoolClicked"/><TextBlock x:Name="CatalogText" VerticalAlignment="Center" Text="尚未加载卡库"/></WrapPanel>
          <WrapPanel Grid.Row="1"><TextBox x:Name="SearchBox" Width="300" ToolTip="输入中文名称或效果" KeyDown="SearchKeyDown"/><TextBlock Text="关键词" VerticalAlignment="Center" Margin="0,0,6,6"/><TextBox x:Name="KeywordBox" Width="100" ToolTip="如 BATTLECRY、DEATHRATTLE"/><CheckBox x:Name="HunterOnlyBox" Content="猎人与中立" IsChecked="True" VerticalAlignment="Center" Margin="8"/><CheckBox x:Name="StandardPoolBox" Content="标准系列成员" VerticalAlignment="Center" Margin="8"/><Button Content="搜索" Click="SearchClicked"/></WrapPanel>
          <TextBlock Grid.Row="2" x:Name="PoolStatusText" Text="尚未加载标准卡池证据。" Foreground="#7B5A22" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><DataGrid x:Name="CardGrid" SelectionChanged="CardSelected"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="140"/><DataGridTextColumn Header="费用" Binding="{Binding Cost}" Width="45"/><DataGridTextColumn Header="职业" Binding="{Binding CardClass}" Width="90"/><DataGridTextColumn Header="效果" Binding="{Binding Text}" Width="*"/><DataGridTextColumn Header="合法性" Binding="{Binding StandardLegality}" Width="80"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Margin="10,0,0,0"><Image x:Name="CardImage" MaxHeight="330" Stretch="Uniform"/><TextBlock x:Name="CardImageText" Text="选择卡牌查看图片" TextWrapping="Wrap"/></StackPanel></Grid>
        </Grid>
      </TabItem>
      <TabItem Header="套牌">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="粘贴游戏导出的套牌代码。保存为不可变版本后，在对局页选择实际使用的套牌。" Margin="0,0,0,10"/><TextBox Grid.Row="1" x:Name="DeckBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><WrapPanel Grid.Row="2"><TextBox x:Name="DeckNameBox" Text="野兽快" Width="140"/><Button Content="解析牌码" Click="DecodeClicked"/><Button Content="保存到套牌库" Click="SaveDeckToLibraryClicked"/><Button Content="导出套牌JSON" Click="SaveDeckClicked"/></WrapPanel><TextBox Grid.Row="3" x:Name="DeckResultBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Grid>
      </TabItem>
      <TabItem Header="对局记录">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><WrapPanel><Button Content="刷新对局与战绩" Click="RefreshHistoryClicked"/><CheckBox x:Name="RankedOnlyBox" Content="仅天梯" IsChecked="True" Margin="8"/><TextBlock Text="build" Margin="8"/><TextBox x:Name="StatsBuildBox" Width="80"/><TextBlock Text="套牌版本ID" Margin="8"/><TextBox x:Name="StatsDeckBox" Width="110"/><TextBlock Text="对手职业" Margin="8"/><TextBox x:Name="StatsOpponentBox" Width="85" ToolTip="如 MAGE，留空显示全部职业"/><ComboBox x:Name="StatsFirstBox" Width="85" SelectedIndex="0"><ComboBoxItem Content="先后手全部"/><ComboBoxItem Content="先手"/><ComboBoxItem Content="后手"/></ComboBox></WrapPanel><WrapPanel><TextBlock x:Name="StatsText" VerticalAlignment="Center" Text="暂无记录" TextWrapping="Wrap"/><TextBlock Text="保留天数" Margin="20,7,6,0"/><TextBox x:Name="RetentionDaysBox" Text="30" Width="55"/><Button Content="清理旧的已结束对局" Click="CleanupHistoryClicked"/></WrapPanel></StackPanel>
          <DataGrid Grid.Row="1" x:Name="SessionsGrid" SelectionChanged="SessionSelected"><DataGrid.Columns><DataGridTextColumn Header="记录时间" Binding="{Binding Time}" Width="140"/><DataGridTextColumn Header="套牌版本" Binding="{Binding Deck}" Width="*"/><DataGridTextColumn Header="对手职业" Binding="{Binding Opponent}" Width="110"/><DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="80"/><DataGridTextColumn Header="回合" Binding="{Binding Value.TurnCount}" Width="60"/><DataGridTextColumn Header="build" Binding="{Binding Value.CardBuild}" Width="100"/><DataGridTextColumn Header="完整" Binding="{Binding Value.IsComplete}" Width="60"/></DataGrid.Columns></DataGrid>
          <TextBlock Grid.Row="2" x:Name="HistoryStatusText" Text="选择一局，再选择回合决策点。分析只使用该时刻及以前的信息。" TextWrapping="Wrap" Margin="0,10"/>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox x:Name="DecisionsList" DisplayMemberPath="Label" SelectionChanged="DecisionSelected" Margin="0,0,12,0"/><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions><Button Content="在 AI 教练分析选中局面" Click="AnalyzeHistoryClicked" HorizontalAlignment="Left"/><TextBox Grid.Row="1" x:Name="HistorySnapshotText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><DataGrid Grid.Row="2" x:Name="EventsGrid"><DataGrid.Columns><DataGridTextColumn Header="事件" Binding="{Binding EventSequence}" Width="65"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="120"/><DataGridTextColumn Header="说明" Binding="{Binding Summary}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Grid>
        </Grid>
      </TabItem>
      <TabItem Header="AI 教练">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="完整模型接口地址" Margin="0,0,0,5"/><TextBox x:Name="EndpointBox" ToolTip="完整Chat Completions接口地址，如 https://你的服务/v1/chat/completions" TextChanged="ModelConfigurationChanged"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="模型名称" Margin="0,0,0,5"/><TextBox x:Name="ModelBox" ToolTip="模型名称" TextChanged="ModelConfigurationChanged"/></StackPanel></Grid>
          <WrapPanel Grid.Row="1"><TextBlock Text="API密钥" VerticalAlignment="Center" Margin="0,0,8,6"/><PasswordBox x:Name="KeyBox" Width="250" Padding="7" Margin="0,0,16,6" PasswordChanged="ModelConfigurationChanged"/><TextBlock Text="局面对应的卡库build" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="SessionBuildBox" Width="120" ToolTip="与当前国服客户端核对后的数字build" TextChanged="BuildChanged"/></WrapPanel>
          <StackPanel Grid.Row="2"><WrapPanel><Button Content="从 .env 重新加载" Click="LoadEnvironmentClicked"/><Button Content="加密保存配置" Click="SaveModelClicked"/><Button x:Name="CheckModelButton" Content="检查连接" Click="CheckModelClicked"/></WrapPanel><TextBlock x:Name="ModelConfigText" Text="尚未配置模型。" TextWrapping="Wrap"/><TextBlock Text="分析会将过滤后的局面和相关卡牌发送到配置的模型服务。动作与斩杀仅在本地规则完整覆盖时确认。" TextWrapping="Wrap" Foreground="#52625A" Margin="0,4,0,12"/><TextBlock x:Name="BudgetText" Text="单局预算：60次模型请求、200,000令牌。用量保存在本机。" Foreground="#52625A" TextWrapping="Wrap"/></StackPanel>
          <WrapPanel Grid.Row="3"><ComboBox x:Name="TaskBox" Width="110" SelectedIndex="0" SelectionChanged="AdviceTaskChanged" Margin="0,0,10,6"><ComboBoxItem Content="回合建议"/><ComboBoxItem Content="留牌建议"/><ComboBoxItem Content="局面复盘"/><ComboBoxItem Content="选择建议"/></ComboBox><Button x:Name="AnalyzeButton" Content="分析当前局面" Click="AnalyzeClicked"/><Button Content="取消分析" Click="CancelAdviceClicked"/><CheckBox x:Name="AutoAdviceBox" Content="稳定决策点自动建议" IsChecked="False" Checked="AutomaticAdviceChanged" Unchecked="AutomaticAdviceChanged" Margin="10"/></WrapPanel>
          <TextBox Grid.Row="4" x:Name="AdviceBox" Text="连接或回放日志后，可为固定局面请求建议。" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15"/>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
