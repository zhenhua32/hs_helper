<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Version>0.1.0-preview.29</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>HsHelper</Product>
    <Description>炉石标准天梯猎人助手</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' == 'true'">10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HsHelper.Core/HsHelper.Core.csproj" />
    <ProjectReference Include="../HsHelper.Ingestion/HsHelper.Ingestion.csproj" />
    <ProjectReference Include="../HsHelper.Cards/HsHelper.Cards.csproj" />
    <ProjectReference Include="../HsHelper.Agent/HsHelper.Agent.csproj" />
    <ProjectReference Include="../HsHelper.Coaching/HsHelper.Coaching.csproj" />
    <ProjectReference Include="../HsHelper.Storage/HsHelper.Storage.csproj" />
  </ItemGroup>
  <ItemGroup><Content Include="../../samples/decks/beast-hunter.txt" Link="samples/decks/beast-hunter.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../../scripts/HsHelper.InputCompatibility.cmd" Link="HsHelper.InputCompatibility.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
