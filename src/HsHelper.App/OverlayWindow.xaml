<Window x:Class="HsHelper.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="猎人助手悬浮窗" Width="360" Height="620" MinWidth="220" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="False" ShowActivated="False">
  <Window.Resources>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#F4F8F5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemTemplate">
        <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"/></DataTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F8F5"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#BCD9C2"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>
  </Window.Resources>
  <Border x:Name="ContentRoot" Background="#E81A2B21" BorderBrush="#AF6F9277" BorderThickness="1"
          CornerRadius="10" Padding="12" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="2*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="HeaderMouseDown" Margin="0,0,0,7">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="HeaderText" Text="猎人天梯助手" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="设置" Click="SettingsClicked" Padding="8,3" Margin="6,0,0,0"
                Background="#365442" Foreground="White" BorderBrush="#6B8F75" ToolTip="位置、缩放和鼠标穿透"/>
      </Grid>
      <TextBlock Grid.Row="1" x:Name="QualityText" Text="尚未连接日志" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
      <Border Grid.Row="2" Background="#703D5E46" Padding="8" CornerRadius="5" Margin="0,0,0,8">
        <TextBlock x:Name="AdviceText" Text="等待局面或 AI 建议。" TextWrapping="Wrap" MaxHeight="90" TextTrimming="CharacterEllipsis"/>
      </Border>
      <DockPanel Grid.Row="3" Margin="0,0,0,5">
        <TextBlock DockPanel.Dock="Top" x:Name="HandHeader" Text="我方手牌" Style="{StaticResource SectionTitle}"/>
        <ListBox x:Name="HandList"/>
      </DockPanel>
      <DockPanel Grid.Row="4" Margin="0,0,0,5">
        <TextBlock DockPanel.Dock="Top" x:Name="RemainingHeader" Text="剩余牌库" Style="{StaticResource SectionTitle}"/>
        <ListBox x:Name="RemainingList"/>
      </DockPanel>
      <DockPanel Grid.Row="5" Margin="0,0,0,5">
        <TextBlock DockPanel.Dock="Top" x:Name="OpponentHeader" Text="对手已出牌" Style="{StaticResource SectionTitle}"/>
        <ListBox x:Name="OpponentList"/>
      </DockPanel>
      <TextBlock Grid.Row="6" x:Name="InteractionText" Text="拖动标题移动 · 设置中调整缩放与穿透"
                 Foreground="#9EB5A4" TextWrapping="Wrap" FontSize="10" Margin="0,5,12,0"/>
    </Grid>
  </Border>
</Window>
